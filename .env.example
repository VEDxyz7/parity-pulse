APP_ENV=development
# LIVE preserves the existing application path; execution remains DRY_RUN.
# DEMO uses only in-memory databases and requires DATA_MODE=DEMO.
RUNTIME_MODE=LIVE
DATA_MODE=DEMO
EXECUTION_MODE=DRY_RUN
APPROVAL_MODE=PROPOSE_ONLY
LIVE_TRADING_ENABLED=false
REQUIRE_SIMULATION=true
POSTOPEN_EXIT_MINUTES=10
DATABASE_URL=sqlite:///./data/parity-pulse.db
LOG_LEVEL=INFO

# Read-only provider credentials. DEMO startup does not require them.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
MASSIVE_DATA_QUALITY=UNKNOWN
MASSIVE_API_KEY=
LLM_API_KEY=
# Interpretation only; disabled by default. No implicit provider or model.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
# Credential-free HTTPS, versioned Chat Completions base URL (omit endpoint suffix).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_BYTES=50000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_STRUCTURED_OUTPUT=true

# --- Live wallet rebalancing (BSC mainnet) -------------------------------------------
# Read-only wallet planning: DATA_MODE=LIVE_READ_ONLY + PORTFOLIO_INVENTORY=WALLET +
# LIVE_WALLET_ADDRESS. Holdings are read from chain; nothing is sent.
PORTFOLIO_INVENTORY=POSITIONS
LIVE_WALLET_ADDRESS=
# Trust classifier is parked: rebalancing plans on cost/liquidity/risk/freshness alone.
TRUST_REQUIRED_FOR_REBALANCE=true
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Live execution needs ALL of: EXECUTION_MODE=LIVE, LIVE_TRADING_ENABLED=true,
# RUNTIME_MODE=LIVE, DATA_MODE=LIVE_READ_ONLY, PORTFOLIO_INVENTORY=WALLET and a cap.
LIVE_MAX_NOTIONAL_USD=
LIVE_MAX_SLIPPAGE_BPS=100
# LOCAL_KEY (dev EOA key below) | AGENTIC_WALLET (baw CLI) | ALTANA (Agent Studio sidecar)
LIVE_SIGNER=LOCAL_KEY
LIVE_SIGNER_PRIVATE_KEY=
ALTANA_SIDECAR_URL=http://127.0.0.1:8787
SIDECAR_TOKEN=
# Weekend/off-hours: swap on on-chain pools at half cap while the stock market is closed.
CLOSED_MARKET_SWAP=true
# RFQ (Ondo/bStock market makers, issuer sessions only). Orders are verified against signed
# bounds before signing. Add settlement contracts after verifying them on BscScan, e.g.
# RFQ_SETTLEMENT_ALLOWLIST=PcsXRfq:0x<reactor>
RFQ_ENABLED=true
RFQ_SETTLEMENT_ALLOWLIST=
