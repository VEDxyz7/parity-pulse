APP_ENV=development
# LIVE preserves the existing application path; execution remains DRY_RUN.
# DEMO uses only in-memory databases and requires DATA_MODE=DEMO.
RUNTIME_MODE=LIVE
DATA_MODE=DEMO
EXECUTION_MODE=DRY_RUN
APPROVAL_MODE=PROPOSE_ONLY
LIVE_TRADING_ENABLED=false
REQUIRE_SIMULATION=true
DATABASE_URL=sqlite:///./data/parity-pulse.db
LOG_LEVEL=INFO

# Read-only provider credentials. DEMO startup does not require them.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=
MASSIVE_DATA_QUALITY=UNKNOWN
MASSIVE_API_KEY=
LLM_API_KEY=
